# Copie para .env e ajuste. Nenhum valor abaixo é segredo real.
# Chave secreta do Django (obrigatória em produção). Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=0
# Hosts pelos quais o sistema será acessado (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para formulários quando houver domínio/HTTPS (ex.: https://cronomed.unipe.edu.br)
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 quando o acesso for exclusivamente por HTTPS (cookies seguros)
DJANGO_HTTPS=0
# Banco de dados. Sem esta variável, usa SQLite (db.sqlite3) — adequado apenas a testes locais.
DATABASE_URL=postgres://cronomed:troque-esta-senha@db:5432/cronomed
POSTGRES_PASSWORD=troque-esta-senha
# Senha dos usuários FICTÍCIOS criados por "seed_demo". Se vazia, uma senha aleatória é gerada e exibida no terminal.
CRONOMED_DEMO_PASSWORD=
# Domínios institucionais aceitos no autocadastro de professores (separados por vírgula)
CRONOMED_DOMINIOS_CADASTRO=unipe.edu.br
# Código de convite exigido no autocadastro de professores
CRONOMED_CODIGO_CONVITE=primeiro-ano
